{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-spotify-az-de-001"
		},
		"AzureDataLakeStorage_Spotify_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage_Spotify'"
		},
		"spotifysqldata_source_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'spotifysqldata_source'"
		},
		"AzureDataLakeStorage_Spotify_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stspotifyazde01.dfs.core.windows.net/"
		},
		"spotifysqldata_source_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "spotifyazde-sqlserver.database.windows.net"
		},
		"spotifysqldata_source_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "spotifyazde-sqldb"
		},
		"spotifysqldata_source_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "df-spotify-az-de-001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage_Spotify_accountKey": {
						"value": "[parameters('AzureDataLakeStorage_Spotify_accountKey')]"
					},
					"spotifysqldata_source_password": {
						"value": "[parameters('spotifysqldata_source_password')]"
					},
					"AzureDataLakeStorage_Spotify_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage_Spotify_properties_typeProperties_url')]"
					},
					"spotifysqldata_source_properties_typeProperties_server": {
						"value": "[parameters('spotifysqldata_source_properties_typeProperties_server')]"
					},
					"spotifysqldata_source_properties_typeProperties_database": {
						"value": "[parameters('spotifysqldata_source_properties_typeProperties_database')]"
					},
					"spotifysqldata_source_properties_typeProperties_userName": {
						"value": "[parameters('spotifysqldata_source_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}